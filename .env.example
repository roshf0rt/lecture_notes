# Telegram bot token from @BotFather (the only secret the server needs).
TELEGRAM_BOT_TOKEN=

# Model used for transcription and notes. Each user's own Gemini key is used with it.
GEMINI_MODEL=gemini-3.5-flash-lite

# Where settings and encrypted user keys are stored. On the server: /var/lib/notes-bot
DATA_DIR=data

# Telegram user IDs of the bot's admins, comma-separated. Admins get /admin.
ADMIN_IDS=

# Optional starting allow list. If set, the bot starts closed to everyone else;
# after that, access is managed in /admin.
ALLOWED_USER_IDS=

# How many notes are made at the same time; the rest wait in a queue.
MAX_PARALLEL_JOBS=3
