# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Used for both transcription and writing the notes.
GEMINI_API_KEY=

# Model used for transcription and notes. Check which models have a free quota
# for your project in AI Studio and change this if needed.
GEMINI_MODEL=gemini-2.5-flash

# Where settings are stored (the SQLite file lives here)
DATA_DIR=data

# Comma-separated Telegram user IDs allowed to use the bot. Empty = everyone.
ALLOWED_USER_IDS=
