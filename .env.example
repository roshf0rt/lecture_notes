# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Claude API key: writes the notes
ANTHROPIC_API_KEY=

# OpenAI API key: transcribes audio (optional; without it the bot accepts only text)
OPENAI_API_KEY=

# Models (defaults shown)
NOTES_MODEL=claude-sonnet-5-5
TRANSCRIBE_MODEL=whisper-1

# Where settings are stored (SQLite file lives here)
DATA_DIR=data

# Comma-separated Telegram user IDs allowed to use the bot. Empty = everyone.
ALLOWED_USER_IDS=
