<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <style>
{{ base_css|safe }}
{{ theme_css|safe }}
  </style>
</head>
<body>
  <header>
    <div class="cover-icon">{{ icon }}</div>
    <h1 class="title">{{ title }}</h1>
    {% if main_idea %}
    <div class="callout tone-blue">
      <p class="callout-label"><span class="callout-icon">{{ main_icon }}</span>{{ main_title }}</p>
      <p>{{ main_idea|safe }}</p>
    </div>
    {% endif %}
  </header>

  {% if show_toc %}
  <nav class="toc">
    <p class="toc-title">Содержание</p>
    <ol class="toc-list">
      {% for s in sections %}
      <li><a href="#{{ s.id }}">{{ s.number }}. {{ s.title }}</a>
        {% if s.subs %}<ol class="toc-sub">{% for sub in s.subs %}<li><a href="#{{ sub.id }}">{{ sub.title|safe }}</a></li>{% endfor %}</ol>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}

  {% for s in sections %}
  <section class="block tone-{{ s.tone }}" id="{{ s.id }}">
    <h2>{{ s.number }}. {% if s.icon %}<span class="heading-icon">{{ s.icon }}</span> {% endif %}{{ s.title }}</h2>
    {% for e in s.elements %}
      {% if e.kind == "paragraph" %}
        <p>{{ e.text|safe }}</p>
      {% elif e.kind == "subheading" %}
        <h3 id="{{ e.id }}">{{ e.text|safe }}</h3>
      {% elif e.kind == "bullets" %}
        <ul class="bullets">{% for item in e.points %}<li>{{ item|safe }}</li>{% endfor %}</ul>
      {% elif e.kind == "numbered" %}
        <ol class="numbered">{% for item in e.points %}<li>{{ item|safe }}</li>{% endfor %}</ol>
      {% elif e.kind == "checklist" %}
        <ul class="checklist">{% for item in e.points %}<li>{{ item|safe }}</li>{% endfor %}</ul>
      {% elif e.kind == "table" %}
        <table>
          {% if e.headers %}<thead><tr>{% for h in e.headers %}<th>{{ h|safe }}</th>{% endfor %}</tr></thead>{% endif %}
          <tbody>
            {% for row in e.rows %}<tr>{% for cell in row %}<td>{{ cell|safe }}</td>{% endfor %}</tr>{% endfor %}
          </tbody>
        </table>
      {% elif e.kind == "callout" %}
        <div class="callout tone-{{ e.tone }} callout-{{ e.callout_kind }}"><p>{% if e.icon %}<span class="callout-icon">{{ e.icon }}</span>{% endif %}{{ e.text|safe }}</p></div>
      {% elif e.kind == "toggle" %}
        <div class="toggle">
          {% if e.title %}<p class="toggle-title">▾ {{ e.title|safe }}</p>{% endif %}
          <p>{{ e.text|safe }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </section>
  {% endfor %}
</body>
</html>
